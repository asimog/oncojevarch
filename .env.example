# OnCodex uses OpenRouter through the Agents SDK model boundary.
OPENROUTER_API_KEY=
LLM_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# TypeSafe / Jev uses the direct TypeSafe API by default.
TYPESAFE_API_KEY=
JEV_MODEL=jev

# Optional Codex tool credential. Existing Codex CLI authentication may also be used.
CODEX_API_KEY=

# Local lab state
ONCOJEV_STORE_DIR=.oncojev

# Disable OpenAI Agents tracing if your provider/setup should not send traces.
OPENAI_AGENTS_DISABLE_TRACING=1

# Canonical aliases also accepted: ONCOJEV_AGENT_MODEL and ONCOJEV_JEV_MODEL.
